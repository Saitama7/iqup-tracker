# Cloudflare Pages: the entry points must be revalidated on every load, otherwise a deploy keeps
# serving the old service worker and bundle (#56). Hashed assets never change — cache forever.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
